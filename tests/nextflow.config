/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

aws.client.anonymous = true

// Conditionally include cached reference data paths if all expected NXF_ variables are set
includeConfig ({
    def vars = ['NXF_REF_DATA_PATH', 'NXF_REF_BWAMEM2_INDEX', 'NXF_REF_GRIDSS_INDEX', 'NXF_REF_STAR_INDEX', 'NXF_REF_HMF_DATA']
    def present = vars.findAll { System.getenv(it) }
    if (present.size() == vars.size()) {
        return 'cached_refs.config'
    } else if (present) {
        def missing = vars - present
        throw new Exception("Incomplete cached reference config: some NXF_REF_* variables are set but not all. Set all of: ${vars.join(', ')} or unset all of them. Missing: ${missing.join(', ')}")
    }
    return '/dev/null'
}())
