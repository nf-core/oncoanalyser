def get_saveas_path(meta, task, filename, dest_path, panel_resource_creation = false) {

    if (filename.equals('versions.yml')) {
        return null
    }

    if(!filename.startsWith('.command')) {
        return dest_path
    }

    // Save log files by removing the leading '.' to make files not hidden (Nextflow skips publishing hidden files)
    def selected_command_files = [
        '.command.sh',
        '.command.out',
        '.command.err',
        '.command.log',
        '.command.run'
    ]

    if(!selected_command_files.contains(filename)){
        return null
    }

    def process_name = task.process.toLowerCase().replaceFirst(/^.+:/, '')
    def log_dest_path = panel_resource_creation
        ? "panel_resources/logs/${process_name}${filename}"
        : "${meta.key}/logs/${meta.id}.${process_name}${filename}"

    return log_dest_path
}
